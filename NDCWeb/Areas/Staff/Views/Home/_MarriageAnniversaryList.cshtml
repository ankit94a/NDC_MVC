
@model IEnumerable<NDCWeb.Areas.Member.View_Models.MarriageAnniversaryAlertVM>

<table>
    <tr class="card-header bg-warning text-dark fw-bold">
        <td colspan="4">💍 Marriage Anniversaries</td>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FullName)
            </td>
            @*<td>
                @Html.DisplayFor(modelItem => item.DOMarriage)
            </td>*@
        </tr>
    }
</table>
